<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sentinel.Desktop.ViewModels"
             xmlns:core="using:Sentinel.Core.Models"
             x:Class="Sentinel.Desktop.Views.CalendarsView"
             x:DataType="vm:CalendarsViewModel">

    <Design.DataContext>
        <vm:CalendarsViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Trading calendars" Classes="page-title"/>
                <TextBlock Text="Session-aware calendars for 24/7 follow-the-sun operations" Classes="caption"/>
            </StackPanel>
            <Border Grid.Column="1" Classes="status-pill" VerticalAlignment="Top"
                    Background="{Binding IsMarketOpen, Converter={StaticResource StatusToBackground}}">
                <TextBlock FontSize="12" FontWeight="SemiBold"
                           Text="{Binding CurrentSessionName, StringFormat='Session: {0}'}"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="280,*" ColumnSpacing="12">
            <Border Classes="card" Padding="8">
                <ListBox ItemsSource="{Binding Calendars}" SelectedItem="{Binding SelectedCalendar}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="core:TradingCalendar">
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding TimeZone}" Classes="caption"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="12">
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedCalendar.Name}" Classes="section-title"/>
                            <TextBlock Text="{Binding SelectedCalendar.Description}" Classes="caption" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Text="Sessions" Classes="section-title"/>
                            <ItemsControl ItemsSource="{Binding Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:TradingSession">
                                        <Border Padding="10" Margin="0,0,0,8" Background="{DynamicResource SurfaceBrush}" CornerRadius="8">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="{Binding Region}" Classes="caption"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding OpenTime}" Classes="caption" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding CloseTime}" Classes="caption" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Text="Holidays" Classes="section-title"/>
                            <DataGrid ItemsSource="{Binding Holidays}" Height="180" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
