<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sentinel.Desktop.ViewModels"
             x:Class="Sentinel.Desktop.Views.MigrationWizardView"
             x:DataType="vm:MigrationWizardViewModel">

    <Design.DataContext>
        <vm:MigrationWizardViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*">
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="JIL migration wizard" Classes="page-title"/>
            <TextBlock Text="Import AutoSys jobs, classify risk, then convert to Sentinel workflows" Classes="caption"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
            <Border Classes="step-dot" Classes.active="{Binding IsStep1}" Classes.complete="{Binding !IsStep1}">
                <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Border>
            <TextBlock Text="Import" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
            <Border Classes="step-dot" Classes.active="{Binding IsStep2}" Classes.complete="{Binding IsStep3}">
                <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Border>
            <TextBlock Text="Classify" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
            <Border Classes="step-dot" Classes.active="{Binding IsStep3}" Classes.complete="{Binding IsStep4}">
                <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Border>
            <TextBlock Text="Convert" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
            <Border Classes="step-dot" Classes.active="{Binding IsStep4}">
                <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Border>
            <TextBlock Text="Import" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
        </StackPanel>

        <Border Grid.Row="2" Classes="card">
            <Grid>
                <StackPanel Spacing="12" IsVisible="{Binding IsStep1}">
                    <TextBlock Text="Paste JIL or load a sample file" Classes="section-title"/>
                    <TextBox Text="{Binding JilContent}" AcceptsReturn="True" Height="280" FontFamily="JetBrains Mono, Consolas, monospace" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost" Content="Load sample JIL" Command="{Binding LoadSampleCommand}"/>
                        <Button Classes="ghost" Content="Choose file…" Command="{Binding SelectJilFileCommand}"/>
                        <Button Classes="primary" Content="Parse jobs" Command="{Binding ParseJilCommand}" IsEnabled="{Binding !IsProcessing}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="12" IsVisible="{Binding IsStep2}">
                    <Grid ColumnDefinitions="*,*,*,*">
                        <Border Classes="stat-card" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Confidence" Classes="caption"/>
                                <TextBlock Text="{Binding OverallConfidence, StringFormat='{}{0:F0}%'}" Classes="metric"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="stat-card" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Low risk" Classes="caption"/>
                                <TextBlock Text="{Binding LowRiskCount}" Classes="metric" Foreground="{DynamicResource SuccessBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="stat-card" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="Medium" Classes="caption"/>
                                <TextBlock Text="{Binding MediumRiskCount}" Classes="metric" Foreground="{DynamicResource WarningBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Classes="stat-card" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="High" Classes="caption"/>
                                <TextBlock Text="{Binding HighRiskCount}" Classes="metric" Foreground="{DynamicResource DangerBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <DataGrid ItemsSource="{Binding ImportedJobs}" Height="280" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Job" Binding="{Binding JobName}" Width="2*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding JobType}" Width="*"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceText}" Width="100"/>
                            <DataGridTextColumn Header="Risk" Binding="{Binding RiskText}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox Content="Parallel conversion" IsChecked="{Binding EnableParallelMigration}"/>
                        <CheckBox Content="Skip validation for low risk" IsChecked="{Binding SkipValidationForLowRisk}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost" Content="Back" Command="{Binding BackCommand}"/>
                        <Button Classes="primary" Content="Convert jobs" Command="{Binding ConvertJobsCommand}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="12" IsVisible="{Binding IsStep3}">
                    <TextBlock Text="Conversion results" Classes="section-title"/>
                    <DataGrid ItemsSource="{Binding ConversionResults}" Height="320" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Job" Binding="{Binding JobName}" Width="2*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Workflow" Binding="{Binding WorkflowId}" Width="120"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="ghost" Content="Back" Command="{Binding BackCommand}"/>
                        <Button Classes="primary" Content="Import drafts" Command="{Binding StartMigrationCommand}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsStep4}">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource SuccessBrush}">
                        <PathIcon Data="{StaticResource Icon.Check}" Width="24" Height="24" Foreground="White"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Migration complete" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ImportedWorkflowCount, StringFormat='{}{0} workflows imported as drafts'}"
                               Classes="caption" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Classes="primary" Content="Open drafts in Workflows" Command="{Binding OpenDraftsCommand}"/>
                        <Button Classes="ghost" Content="Start another import" Command="{Binding ResetCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
