<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sentinel.Desktop.ViewModels"
             x:Class="Sentinel.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    
    <StackPanel Margin="24">
        <TextBlock Text="Settings" Classes="page-title"/>
        <TextBlock Text="Application configuration and preferences" Classes="caption"/>
        
        <Border Classes="card" Margin="0,24,0,0" MinHeight="400">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⚙️" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,8" HorizontalAlignment="Center"/>
                <TextBlock Text="API configuration, notifications, and theme preferences" 
                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </StackPanel>
    
</UserControl>
