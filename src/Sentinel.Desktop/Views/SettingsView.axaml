<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sentinel.Desktop.ViewModels"
             x:Class="Sentinel.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <Design.DataContext>
        <vm:SettingsViewModel/>
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Settings" Classes="page-title"/>
                <TextBlock Text="Local desktop preferences. Values persist for this session." Classes="caption"/>
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Connection" Classes="section-title"/>
                    <TextBlock Text="API base URL" Classes="caption"/>
                    <TextBox Text="{Binding ApiBaseUrl}"/>
                    <CheckBox Content="Enable realtime SignalR (requires a running API)" IsChecked="{Binding EnableRealtime}"/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance" Classes="section-title"/>
                    <TextBlock Text="Theme" Classes="caption"/>
                    <ComboBox Width="200" HorizontalAlignment="Left" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"/>
                    <TextBlock Text="Dashboard refresh (seconds)" Classes="caption"/>
                    <TextBox Width="160" HorizontalAlignment="Left" Text="{Binding RefreshIntervalSeconds}"/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Notifications" Classes="section-title"/>
                    <CheckBox Content="Show toast notifications" IsChecked="{Binding EnableNotifications}"/>
                    <CheckBox Content="Share anonymous telemetry" IsChecked="{Binding EnableTelemetry}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}"/>
                <Button Classes="ghost" Content="Reset defaults" Command="{Binding ResetCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
