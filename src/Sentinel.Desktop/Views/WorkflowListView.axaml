<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sentinel.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="Sentinel.Desktop.Views.WorkflowListView"
             x:Name="WorkflowRoot"
             x:DataType="vm:WorkflowListViewModel">

    <Design.DataContext>
        <vm:WorkflowListViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Workflows" Classes="page-title"/>
                    <TextBlock Text="Schedule, trigger, and inspect orchestration graphs" Classes="caption"/>
                </StackPanel>
                <Button Grid.Column="1" Classes="primary" Command="{Binding CreateWorkflowCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource Icon.Plus}" Width="14" Height="14"/>
                        <TextBlock Text="New workflow"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="1" Classes="card" Margin="0,0,0,12" Padding="12">
                <Grid ColumnDefinitions="280,*,Auto" ColumnSpacing="12">
                    <TextBox Classes="search-box" Watermark="Search workflows…" Text="{Binding SearchQuery}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <ComboBox MinWidth="130" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding StatusFilter}"/>
                        <ComboBox MinWidth="130" ItemsSource="{Binding RegionOptions}" SelectedItem="{Binding RegionFilter}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Classes="card" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Workflows}"
                              SelectedItem="{Binding SelectedWorkflow}"
                              AutoGenerateColumns="False"
                              IsVisible="{Binding HasWorkflows}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTemplateColumn Header="Status" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:WorkflowListItem">
                                    <Border Classes="status-pill" Margin="8,0"
                                            Background="{Binding Status, Converter={StaticResource StatusToBackground}}">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Region" Binding="{Binding Region}" Width="*"/>
                        <DataGridTextColumn Header="SLA" Binding="{Binding SlaDisplay}" Width="70"/>
                        <DataGridTextColumn Header="Runs" Binding="{Binding TotalRuns}" Width="80"/>
                        <DataGridTemplateColumn Header="Success" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:WorkflowListItem">
                                    <TextBlock Text="{Binding SuccessRateText}" VerticalAlignment="Center" Margin="8,0"
                                               Foreground="{Binding SuccessRate, Converter={StaticResource PercentageToColor}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Schedule" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:WorkflowListItem">
                                    <TextBlock Text="{Binding ScheduleDisplay}" Margin="8,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextBrush}"
                                               ToolTip.Tip="{Binding Schedule}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Actions" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:WorkflowListItem">
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0">
                                        <Button Classes="success" Padding="8,4"
                                                ToolTip.Tip="Run now"
                                                Command="{Binding #WorkflowRoot.((vm:WorkflowListViewModel)DataContext).TriggerWorkflowCommand}"
                                                CommandParameter="{Binding}">
                                            <PathIcon Data="{StaticResource Icon.Runs}" Width="12" Height="12"/>
                                        </Button>
                                        <Button Classes="ghost" Padding="8,4"
                                                ToolTip.Tip="View runs"
                                                Command="{Binding #WorkflowRoot.((vm:WorkflowListViewModel)DataContext).ViewRunsCommand}"
                                                CommandParameter="{Binding}">
                                            <PathIcon Data="{StaticResource Icon.List}" Width="12" Height="12"/>
                                        </Button>
                                        <Button Classes="ghost" Padding="8,4"
                                                ToolTip.Tip="Edit"
                                                Command="{Binding #WorkflowRoot.((vm:WorkflowListViewModel)DataContext).EditWorkflowCommand}"
                                                CommandParameter="{Binding}">
                                            <PathIcon Data="{StaticResource Icon.Edit}" Width="12" Height="12"/>
                                        </Button>
                                        <Button Classes="ghost" Padding="8,4" ToolTip.Tip="More">
                                            <PathIcon Data="{StaticResource Icon.More}" Width="12" Height="12"/>
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="Duplicate"
                                                              Command="{Binding #WorkflowRoot.((vm:WorkflowListViewModel)DataContext).DuplicateWorkflowCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="{Binding PauseResumeLabel}"
                                                              Command="{Binding #WorkflowRoot.((vm:WorkflowListViewModel)DataContext).PauseOrResumeCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Archive"
                                                              Command="{Binding #WorkflowRoot.((vm:WorkflowListViewModel)DataContext).ArchiveWorkflowCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Delete"
                                                              Command="{Binding #WorkflowRoot.((vm:WorkflowListViewModel)DataContext).DeleteWorkflowCommand}"
                                                              CommandParameter="{Binding}"/>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="{Binding EmptyMessage}" Classes="empty-state"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !HasWorkflows}"/>
                </Grid>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsEditorOpen}" ZIndex="10">
            <Button Command="{Binding CancelEditorCommand}"
                    Background="{DynamicResource OverlayBrush}"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>
            <Border Classes="card" Width="640" MaxHeight="800" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 16 40 0 #66000000">
                <ScrollViewer MaxHeight="720">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding EditorTitle}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Name" Classes="caption"/>
                    <TextBox Classes="form-field" Watermark="e.g. Intraday PnL Flash" Text="{Binding DraftName}"/>
                    <TextBlock Text="Description" Classes="caption"/>
                    <TextBox Classes="form-field" Watermark="What this workflow does"
                             AcceptsReturn="True" Height="64" Text="{Binding DraftDescription}"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel>
                            <TextBlock Text="Region" Classes="caption" Margin="0,0,0,6"/>
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding EditorRegionOptions}" SelectedItem="{Binding DraftRegion}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Status" Classes="caption" Margin="0,0,0,6"/>
                            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding EditorStatusOptions}" SelectedItem="{Binding DraftStatus}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Schedule" Classes="caption"/>
                    <TextBox Classes="form-field"
                             Watermark="every 15 minutes, weekdays at 5pm, or cron"
                             Text="{Binding DraftScheduleHuman}"/>
                    <WrapPanel>
                        <ItemsControl ItemsSource="{Binding SchedulePresets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="ghost" Padding="10,5" FontSize="11" Margin="0,0,6,6"
                                            Content="{Binding}"
                                            Command="{Binding #WorkflowRoot.((vm:WorkflowListViewModel)DataContext).ApplySchedulePresetCommand}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                    <TextBlock Text="{Binding SchedulePreview}" Classes="caption" IsVisible="{Binding ScheduleIsValid}"/>
                    <TextBlock Text="{Binding SchedulePreview}" FontSize="12" Foreground="{DynamicResource DangerBrush}"
                               IsVisible="{Binding !ScheduleIsValid}"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel>
                            <TextBlock Text="Expected duration (minutes)" Classes="caption" Margin="0,0,0,6"/>
                            <NumericUpDown Minimum="1" Maximum="1440" Increment="1" FormatString="0"
                                           Value="{Binding DraftSlaExpectedMinutes}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SLA warning (minutes)" Classes="caption" Margin="0,0,0,6"/>
                            <NumericUpDown Minimum="1" Maximum="1440" Increment="1" FormatString="0"
                                           Value="{Binding DraftSlaWarningMinutes}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Tasks" Classes="caption"/>
                    <TextBlock Text="Order is top to bottom. Each task waits for the one above it to succeed." Classes="caption"/>
                    <ItemsControl ItemsSource="{Binding DraftTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkflowTaskDraft">
                                <Grid ColumnDefinitions="1.2*,0.8*,1.6*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                                    <TextBox Classes="form-field" Watermark="Task name" Text="{Binding Name}"/>
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding #WorkflowRoot.((vm:WorkflowListViewModel)DataContext).TaskTypes}"
                                              SelectedItem="{Binding Type}"/>
                                    <TextBox Grid.Column="2" Classes="form-field" Watermark="Command" Text="{Binding Command}"/>
                                    <Button Grid.Column="3" Classes="icon-button"
                                            ToolTip.Tip="Remove task"
                                            Command="{Binding #WorkflowRoot.((vm:WorkflowListViewModel)DataContext).RemoveTaskCommand}"
                                            CommandParameter="{Binding}">
                                        <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12"
                                                  Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding AddTaskCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.Plus}" Width="12" Height="12"/>
                            <TextBlock Text="Add task"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Service parameters" Classes="caption"/>
                    <TextBlock Text="Optional name/value pairs passed to each task (queue, machine, env, …)." Classes="caption"/>
                    <ItemsControl ItemsSource="{Binding DraftParameters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkflowParameterItem">
                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                                    <TextBox Classes="form-field" Watermark="Name" Text="{Binding Key}"/>
                                    <TextBox Grid.Column="1" Classes="form-field" Watermark="Value" Text="{Binding Value}"/>
                                    <Button Grid.Column="2" Classes="icon-button"
                                            ToolTip.Tip="Remove"
                                            Command="{Binding #WorkflowRoot.((vm:WorkflowListViewModel)DataContext).RemoveParameterCommand}"
                                            CommandParameter="{Binding}">
                                        <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12"
                                                  Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding AddParameterCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.Plus}" Width="12" Height="12"/>
                            <TextBlock Text="Add parameter"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding EditorError}" Foreground="{DynamicResource DangerBrush}"
                               IsVisible="{Binding EditorError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Classes="ghost" Content="Cancel" Command="{Binding CancelEditorCommand}"/>
                        <Button Classes="primary" Content="Save" Command="{Binding SaveWorkflowCommand}"
                                IsEnabled="{Binding CanSaveWorkflow}"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
