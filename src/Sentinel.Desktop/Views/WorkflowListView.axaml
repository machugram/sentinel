<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sentinel.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="Sentinel.Desktop.Views.WorkflowListView"
             x:DataType="vm:WorkflowListViewModel">
    
    <Design.DataContext>
        <vm:WorkflowListViewModel/>
    </Design.DataContext>
    
    <Grid RowDefinitions="Auto,Auto,*">
        
        <!-- Page Header -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Workflows" Classes="page-title"/>
                <TextBlock Text="Manage and monitor your orchestration workflows" Classes="caption"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" Command="{Binding CreateWorkflowCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="+" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="New Workflow"/>
                </StackPanel>
            </Button>
        </Grid>
        
        <!-- Search and Filters -->
        <Border Grid.Row="1" Classes="card" Margin="0,0,0,16" Padding="16">
            <Grid ColumnDefinitions="300,*,Auto">
                <TextBox Grid.Column="0" 
                         Watermark="Search workflows..." 
                         Text="{Binding SearchQuery}"
                         VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <ComboBox MinWidth="120" PlaceholderText="Status">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Active"/>
                        <ComboBoxItem Content="Paused"/>
                        <ComboBoxItem Content="Archived"/>
                    </ComboBox>
                    <ComboBox MinWidth="120" PlaceholderText="Region">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Americas"/>
                        <ComboBoxItem Content="EMEA"/>
                        <ComboBoxItem Content="APAC"/>
                        <ComboBoxItem Content="Global"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Workflow List -->
        <Border Grid.Row="2" Classes="card">
            <DataGrid ItemsSource="{Binding Workflows}"
                      SelectedItem="{Binding SelectedWorkflow}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                    <DataGridTextColumn Header="Region" Binding="{Binding Region}" Width="*"/>
                    <DataGridTextColumn Header="Total Runs" Binding="{Binding TotalRuns}" Width="*"/>
                    <DataGridTextColumn Header="Success Rate" Binding="{Binding SuccessRateText}" Width="*"/>
                    <DataGridTextColumn Header="Schedule" Binding="{Binding Schedule}" Width="*"/>
                    <DataGridTemplateColumn Header="Actions" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="▶" Classes="success" Padding="8,4" FontSize="12"
                                            ToolTip.Tip="Run Now"/>
                                    <Button Content="✏" Background="Transparent" BorderThickness="0" Padding="8,4"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            ToolTip.Tip="Edit"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        
    </Grid>
    
</UserControl>
