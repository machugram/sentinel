<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sentinel.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="Sentinel.Desktop.Views.DashboardView"
             x:Name="DashboardRoot"
             x:DataType="vm:DashboardViewModel">

    <Design.DataContext>
        <vm:DashboardViewModel/>
    </Design.DataContext>

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Text="Operations dashboard" Classes="page-title"/>
                        <TextBlock Text="Live status for trading workflows, SLAs, and alerts" Classes="caption"/>
                    </StackPanel>
                    <Button Grid.Column="1" Classes="ghost" Command="{Binding RefreshDataCommand}" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Refresh}" Width="14" Height="14"/>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                    <Border Classes="stat-card">
                        <StackPanel>
                            <TextBlock Text="Active workflows" Classes="caption"/>
                            <TextBlock Text="{Binding ActiveWorkflows}" Classes="metric" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding ActiveTrend}" Classes="caption" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="stat-card">
                        <StackPanel>
                            <TextBlock Text="Running jobs" Classes="caption"/>
                            <TextBlock Text="{Binding RunningJobs}" Classes="metric" Foreground="{DynamicResource AccentBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding RunningTrend}" Classes="caption" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="stat-card">
                        <StackPanel>
                            <TextBlock Text="Success rate (24h)" Classes="caption"/>
                            <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,8,0,0">
                                <TextBlock Text="{Binding SuccessRate}" FontSize="28" FontWeight="Bold"
                                           Foreground="{Binding SuccessRate, Converter={StaticResource PercentageToColor}}"/>
                                <TextBlock Text="%" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                           Foreground="{Binding SuccessRate, Converter={StaticResource PercentageToColor}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SuccessTrend}" Classes="caption" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="stat-card">
                        <StackPanel>
                            <TextBlock Text="Pending alerts" Classes="caption"/>
                            <TextBlock Text="{Binding PendingAlerts}" Classes="metric" Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding AlertTrend}" Classes="caption" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="1.6*,*" ColumnSpacing="12">
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Text="Recent runs" Classes="section-title"/>
                            <ItemsControl ItemsSource="{Binding RecentRuns}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RecentRunItem">
                                        <Button Classes="row-button"
                                                Command="{Binding #DashboardRoot.((vm:DashboardViewModel)DataContext).OpenRunCommand}"
                                                CommandParameter="{Binding}">
                                        <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SurfaceBrush}" CornerRadius="8">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding WorkflowName}" FontWeight="Medium" Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="{Binding TimeAgo}" Classes="caption" Margin="0,4,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Classes="status-pill" VerticalAlignment="Center" Margin="0,0,8,0"
                                                        Background="{DynamicResource WarningBrush}"
                                                        IsVisible="{Binding ExceedsSla}">
                                                    <TextBlock Text="SLA" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding DurationText}" Classes="caption"
                                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                                <Border Grid.Column="3" Classes="status-pill" VerticalAlignment="Center"
                                                        Background="{Binding Status, Converter={StaticResource StatusToBackground}}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Classes="card">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <TextBlock Text="Active alerts" Classes="section-title"/>
                                <Border Background="{DynamicResource DangerBrush}" CornerRadius="10" Padding="8,3"
                                        IsVisible="{Binding HasPendingAlerts}">
                                    <TextBlock Text="{Binding PendingAlerts}" FontSize="11" Foreground="White"/>
                                </Border>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ActiveAlerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AlertItem">
                                        <Button Classes="row-button"
                                                Command="{Binding #DashboardRoot.((vm:DashboardViewModel)DataContext).OpenAlertCommand}"
                                                CommandParameter="{Binding}">
                                        <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                                                BorderThickness="3,0,0,0"
                                                BorderBrush="{Binding Severity, Converter={StaticResource SeverityToBrush}}">
                                            <StackPanel>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                                                    <Border Grid.Column="1" Classes="status-pill"
                                                            Background="{Binding Severity, Converter={StaticResource SeverityToBackground}}">
                                                        <TextBlock Text="{Binding SeverityText}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Message}" Classes="caption" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding TimeAgo}" Classes="caption" Margin="0,6,0,0" Opacity="0.8"/>
                                            </StackPanel>
                                        </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Background="{DynamicResource OverlayBrush}" IsVisible="{Binding IsLoading}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressBar IsIndeterminate="True" Width="220"/>
                <TextBlock Text="Refreshing operations data…" Classes="caption" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
