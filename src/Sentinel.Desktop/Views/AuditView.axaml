<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sentinel.Desktop.ViewModels"
             x:Class="Sentinel.Desktop.Views.AuditView"
             x:DataType="vm:AuditViewModel">

    <Design.DataContext>
        <vm:AuditViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Audit trail" Classes="page-title"/>
                <TextBlock Text="Immutable activity log for operators, schedulers, and migrations" Classes="caption"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="ghost" Command="{Binding ExportCommand}" CommandParameter="ndjson">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource Icon.Export}" Width="14" Height="14"/>
                        <TextBlock Text="Export NDJSON"/>
                    </StackPanel>
                </Button>
                <Button Classes="primary" Content="Export CSV" Command="{Binding ExportCommand}" CommandParameter="csv"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Classes="card" Margin="0,0,0,12" Padding="12">
            <Grid ColumnDefinitions="320,*">
                <TextBox Classes="search-box" Watermark="Filter action, user, entity…" Text="{Binding SearchQuery}"/>
                <TextBlock Grid.Column="1" Text="{Binding ExportStatus}" Classes="caption" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Classes="card" Padding="0">
            <DataGrid ItemsSource="{Binding Entries}" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="When" Binding="{Binding Timestamp, Converter={StaticResource RelativeTime}}" Width="120"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="*"/>
                    <DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="*"/>
                    <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="*"/>
                    <DataGridTextColumn Header="Detail" Binding="{Binding NewValue}" Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
