<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sentinel.Desktop.ViewModels"
             x:Class="Sentinel.Desktop.Views.AuditView"
             x:DataType="vm:AuditViewModel">
    
    <StackPanel Margin="24">
        <TextBlock Text="Audit Logs" Classes="page-title"/>
        <TextBlock Text="Compliance-ready audit trails and evidence export" Classes="caption"/>
        
        <Border Classes="card" Margin="0,24,0,0" MinHeight="400">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="Audit Trail" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,8" HorizontalAlignment="Center"/>
                <TextBlock Text="Immutable logs with digital signatures" 
                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,24,0,0">
                    <Button Classes="primary" Content="Export NDJSON"/>
                    <Button Content="Generate Report" Background="Transparent" 
                            Foreground="{DynamicResource PrimaryBrush}" BorderThickness="1"
                            BorderBrush="{DynamicResource PrimaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
    
</UserControl>
