<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sentinel.Desktop.ViewModels"
        xmlns:models="using:Sentinel.Desktop.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="Sentinel.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Sentinel Orchestrator"
        Width="1440" Height="920"
        MinWidth="1100" MinHeight="700"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding TogglePaletteCommand}"/>
        <KeyBinding Gesture="F5" Command="{Binding RefreshCurrentCommand}"/>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewWorkflowShortcutCommand}"/>
        <KeyBinding Gesture="Escape" Command="{Binding ClosePaletteCommand}"/>
    </Window.KeyBindings>

    <Grid>
        <Grid ColumnDefinitions="Auto,*">

        <Border Grid.Column="0"
                Width="{Binding SidebarWidth}"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">

                <Border Grid.Row="0" Padding="16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                            <PathIcon Data="{StaticResource Icon.Shield}" Width="18" Height="18" Foreground="#11111B"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                    IsVisible="{Binding IsSidebarExpanded}">
                            <TextBlock Text="Sentinel" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="Orchestrator" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Padding="8">
                    <StackPanel Spacing="2">
                        <TextBlock Text="MAIN" Classes="nav-section" IsVisible="{Binding IsSidebarExpanded}"/>
                        <ItemsControl ItemsSource="{Binding MainNavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:NavigationItem">
                                    <Button Classes="nav-button"
                                            Classes.active="{Binding IsActive}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                                            CommandParameter="{Binding ViewKey}"
                                            ToolTip.Tip="{Binding Label}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <PathIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                                                      Width="18" Height="18" Margin="2,0,0,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="12,0,0,0"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarExpanded}"/>
                                            <Border Grid.Column="2" Background="{DynamicResource DangerBrush}" CornerRadius="8"
                                                    Padding="6,1" Margin="8,0,0,0" MinWidth="18"
                                                    IsVisible="{Binding HasBadge}">
                                                <TextBlock Text="{Binding BadgeCount}" FontSize="10" Foreground="White"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="TOOLS" Classes="nav-section" IsVisible="{Binding IsSidebarExpanded}"/>
                        <ItemsControl ItemsSource="{Binding ToolsNavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:NavigationItem">
                                    <Button Classes="nav-button"
                                            Classes.active="{Binding IsActive}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                                            CommandParameter="{Binding ViewKey}"
                                            ToolTip.Tip="{Binding Label}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <PathIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                                                      Width="18" Height="18" Margin="2,0,0,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="12,0,0,0"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarExpanded}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="COMPLIANCE" Classes="nav-section" IsVisible="{Binding IsSidebarExpanded}"/>
                        <ItemsControl ItemsSource="{Binding ComplianceNavItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:NavigationItem">
                                    <Button Classes="nav-button"
                                            Classes.active="{Binding IsActive}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                                            CommandParameter="{Binding ViewKey}"
                                            ToolTip.Tip="{Binding Label}">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <PathIcon Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                                                      Width="18" Height="18" Margin="2,0,0,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="12,0,0,0"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarExpanded}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border CornerRadius="18" Width="36" Height="36" Background="{DynamicResource PrimaryBrush}">
                            <TextBlock Text="{Binding UserInitials}" FontWeight="SemiBold" FontSize="12" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                                    IsVisible="{Binding IsSidebarExpanded}">
                            <TextBlock Text="{Binding UserName}" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="{Binding UserRole}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="icon-button" Command="{Binding NavigateToSettingsCommand}"
                                ToolTip.Tip="Settings">
                            <PathIcon Data="{StaticResource Icon.Settings}" Width="16" Height="16"
                                      Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Classes="command-bar">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Classes="icon-button" Command="{Binding ToggleSidebarCommand}"
                            ToolTip.Tip="Toggle sidebar">
                        <Panel>
                            <PathIcon Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}"
                                      Data="{StaticResource Icon.Collapse}"
                                      IsVisible="{Binding IsSidebarExpanded}"/>
                            <PathIcon Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}"
                                      Data="{StaticResource Icon.Expand}"
                                      IsVisible="{Binding !IsSidebarExpanded}"/>
                        </Panel>
                    </Button>

                    <Border Grid.Column="1" MaxWidth="520" HorizontalAlignment="Left" Margin="12,0">
                        <TextBox Classes="search-box" Watermark="Search workflows…  Ctrl+K"
                                 Text="{Binding GlobalSearch}"
                                 MinWidth="280">
                            <TextBox.InnerLeftContent>
                                <PathIcon Data="{StaticResource Icon.Search}" Width="14" Height="14" Margin="8,0,0,0"
                                          Foreground="{DynamicResource TextMutedBrush}"/>
                            </TextBox.InnerLeftContent>
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SubmitSearchCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="10,5"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding ConnectionLabel}" FontSize="11"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding LastRefreshed, StringFormat='Updated {0:HH:mm:ss}'}"
                                   Classes="caption" VerticalAlignment="Center"/>
                        <Button Classes="icon-button" Command="{Binding ToggleThemeCommand}"
                                ToolTip.Tip="Toggle theme">
                            <Panel>
                                <PathIcon Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}"
                                          Data="{StaticResource Icon.Moon}"
                                          IsVisible="{Binding IsDarkTheme}"/>
                                <PathIcon Width="16" Height="16" Foreground="{DynamicResource TextMutedBrush}"
                                          Data="{StaticResource Icon.Sun}"
                                          IsVisible="{Binding !IsDarkTheme}"/>
                            </Panel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <ContentControl Content="{Binding CurrentView}" Margin="20"/>

                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
                        Classes="card" Padding="14,10" IsVisible="{Binding IsToastVisible}"
                        BoxShadow="0 8 24 0 #66000000">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding ToastMessage}" Foreground="{DynamicResource TextBrush}"
                                   TextWrapping="Wrap" MaxWidth="360" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="icon-button" Command="{Binding DismissToastCommand}">
                            <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12"
                                      Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        </Grid>

        <Grid IsVisible="{Binding IsPaletteOpen}" ZIndex="30">
            <Button Command="{Binding ClosePaletteCommand}"
                    Background="{DynamicResource OverlayBrush}"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"/>
            <Border Classes="card" Width="560" MaxHeight="480" Padding="16"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,72,0,0"
                    BoxShadow="0 16 40 0 #66000000">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <TextBox x:Name="PaletteSearchBox" Classes="search-box"
                             Watermark="Jump to a page, workflow, or action…"
                             Text="{Binding PaletteQuery}">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource Icon.Search}" Width="14" Height="14" Margin="8,0,0,0"
                                      Foreground="{DynamicResource TextMutedBrush}"/>
                        </TextBox.InnerLeftContent>
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding ExecutePaletteItemCommand}"/>
                        </TextBox.KeyBindings>
                    </TextBox>
                    <ListBox Grid.Row="1" ItemsSource="{Binding PaletteResults}"
                             SelectedItem="{Binding SelectedPaletteItem}"
                             MaxHeight="340" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:CommandPaletteItem">
                                <Button Classes="row-button"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExecutePaletteItemCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                            <TextBlock Text="{Binding Subtitle}" Classes="caption" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Kind}" Classes="caption"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="Enter to run · Esc to close · Ctrl+K anytime" Classes="caption"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
